# Plantilla de /home/deploy/mymoney/.env.production en el servidor. NO pongas valores reales aqui: este fichero se versiona.
# El real se crea EN EL SERVIDOR con permisos 600 (ver README.md, "Crear los secretos"); jamas se sube a git,
# ni se pega en chats, tickets o logs.

# Dominio publico de la API (el DNS debe apuntar al VPS).
DOMAIN=mymoney-api.tudominio.dev

# Base de datos. La contrasena debe ser alfanumerica (24+ caracteres): va dentro de una URL.
POSTGRES_USER=mymoney
POSTGRES_PASSWORD=
POSTGRES_DB=mymoney_production

# Firma de los tokens de sesion (32+ caracteres aleatorios). Cambiarla cierra todas las sesiones.
JWT_SECRET=

# Origen EXACTO de la web (https, sin barra final, sin comodines). Varios: separados por comas.
CORS_ORIGINS=https://mymoney.tudominio.dev

# Cuenta personal: el registro publico esta cerrado. Pon true SOLO el rato necesario para crear tu cuenta.
REGISTRATION_ENABLED=false
