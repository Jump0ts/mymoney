generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  categories    Category[]
  transactions  Transaction[]
  budgetGroups  BudgetGroup[]
  budgetItems   BudgetItem[]
  budgetMonths  BudgetMonth[]
  budgetEntries BudgetEntry[]
  savedColors   SavedColor[]
}

model Category {
  id           String          @id @default(cuid())
  user         User            @relation(fields: [userId], references: [id])
  userId       String
  name         String
  icon         String          @default("tag")
  color        String          @default("#6C5CE7")
  type         TransactionType
  createdAt    DateTime        @default(now())
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  category      Category        @relation(fields: [categoryId], references: [id])
  categoryId    String
  type          TransactionType
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("EUR")
  description   String?
  occurredAt    DateTime
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  // Linea del presupuesto que este gasto cubre. Una linea normal admite un solo gasto y un sobre (BudgetEntry.envelope)
  // varios; esa regla la hace cumplir el servidor al enlazar. Si la linea se borra, el movimiento sigue existiendo
  // y solo pierde el enlace.
  budgetEntry   BudgetEntry?    @relation(fields: [budgetEntryId], references: [id], onDelete: SetNull)
  budgetEntryId String?

  @@index([budgetEntryId])
  @@index([userId, occurredAt])
  @@index([userId, categoryId])
  @@index([userId, type])
}

// Grupo de lineas de presupuesto (Hogar, Alquiler, Deseos...). Es global del
// usuario: no se copia cada mes, solo sus lineas. `limit` es un tope opcional
// para la suma de lo previsto en sus lineas (p. ej. "Gastos fijos": 600).
model BudgetGroup {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  name        String
  color       String        @default("#6C5CE7")
  limit       Decimal?      @db.Decimal(12, 2)
  // Grupo que recibe lo que sobra del sueldo tras repartir el resto (como mucho uno por usuario).
  isRemainder Boolean       @default(false)
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  items       BudgetItem[]
  entries     BudgetEntry[]

  @@unique([userId, name])
  @@index([userId])
}

// Linea de la plantilla recurrente: de aqui salen las lineas de cada mes nuevo.
// Un importe negativo es un reembolso (resta).
model BudgetItem {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  group     BudgetGroup   @relation(fields: [groupId], references: [id])
  groupId   String
  name      String
  amount    Decimal       @db.Decimal(12, 2)
  // Sobre: gasto variable con un importe previsto del que se van descontando varios gastos a lo largo del mes
  // (supermercado, gasolina). Si es false, la linea se paga de una vez.
  envelope  Boolean       @default(false)
  position  Int           @default(0)
  createdAt DateTime      @default(now())
  entries   BudgetEntry[]

  @@index([userId])
  @@index([groupId])
}

// Presupuesto de un mes concreto: el sueldo previsto de ese mes.
model BudgetMonth {
  id     String  @id @default(cuid())
  user   User    @relation(fields: [userId], references: [id])
  userId String
  year   Int
  month  Int
  income Decimal @default(0) @db.Decimal(12, 2)

  @@unique([userId, year, month])
}

// Linea de un mes. itemId es null en las lineas puntuales (solo ese mes) y se
// pone a null si se borra el item de la plantilla, para no tocar meses ya hechos.
model BudgetEntry {
  id              String       @id @default(cuid())
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  year            Int
  month           Int
  group           BudgetGroup  @relation(fields: [groupId], references: [id])
  groupId         String
  item            BudgetItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId          String?
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  // Sobre (ver BudgetItem.envelope): admite varios gastos y nunca esta "pagada", lo gastado es la suma de sus gastos.
  envelope        Boolean      @default(false)
  paid            Boolean      @default(false)
  position        Int          @default(0)
  // Editada a mano solo para este mes (nombre, importe o grupo distintos de la plantilla): los cambios de
  // plantilla posteriores no la pisan. Volver a editarla con "este y los siguientes" la devuelve a la plantilla.
  edited          Boolean      @default(false)
  // Linea puntual creada a la vez que un gasto de Movimientos ("Descontar de" un grupo): si ese gasto se borra
  // o deja de cubrirla, la linea se borra con el, porque no existia antes que el.
  fromTransaction Boolean      @default(false)
  createdAt       DateTime     @default(now())
  // Gastos de Movimientos enlazados a esta linea: su importe es el "real" de la linea. En una linea normal hay uno
  // como mucho y la marca como pagada; en un sobre hay los que sean y se suman.
  transactions    Transaction[]

  @@unique([userId, year, month, itemId])
  @@index([userId, year, month])
}

// Colores propios que el usuario guarda para volver a elegirlos al dar color a una categoria o a un grupo del
// presupuesto. Son privados de cada usuario. `hex` va siempre como #RRGGBB en mayusculas (sin duplicados por caso).
model SavedColor {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  hex       String
  createdAt DateTime @default(now())

  @@unique([userId, hex])
}
