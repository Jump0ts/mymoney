# Copia este archivo a .env y rellena los valores reales (nunca commitear .env)

# postgresql://usuario:password@host:puerto/basededatos
DATABASE_URL="postgresql://mymoney:mymoney@localhost:5432/mymoney_dev"

# Secreto para firmar los JWT (usa una cadena larga y aleatoria distinta por entorno)
JWT_SECRET="change-me-in-every-environment"

# pre | staging | production
NODE_ENV="pre"

PORT=4000

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS="http://localhost:8081"
